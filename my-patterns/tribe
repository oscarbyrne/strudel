const tribe = {
  midiport: 'UM-ONE MIDI 1',
  midimap: {
    amp: 7
  },
  tonic: 'C4',
  sync() {
    return midicmd("clock*24*4").midi(this.midiport)
  },
  part(n) {
    const that = this
    return function(...patterns) {
      return stack(...patterns).midi({
        midiport: that.midiport,
        midichannel: n,
        midimap: 'tribe',
      })
    }
  },
  init(bpm) {
    setcpm(bpm/4)
    midimaps({ tribe: tribe.midimap })
  }
}

tribe.init(166)

stack(
  tribe.sync(),
  tribe.part(1)(note("[x ~ ~ ~] [~ ~ x ~] [~ ~ ~ ~] [~ ~ ~ ~]".inhabit({x: 'C4'}))),
  tribe.part(2)(note("[~ ~ ~ ~] [x ~ ~ ~] [~ ~ ~ ~] [x ~ ~ ~]".inhabit({x: 'C4'}))),
  tribe.part(3)(
    note("[x x x x] [x x x x] [x x x x] [x x x x]".inhabit({x: 'C4'})),
    amp( "[7 2 3 4] [7 2 3 4] [7 2 3 4] [7 2 3 4]".div(9))
  ),
)
